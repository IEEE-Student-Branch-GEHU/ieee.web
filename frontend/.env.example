# Copy to .env.local for local development (`npm run dev`). On Vercel, set the
# same keys under Project Settings -> Environment Variables.

# --- Site -------------------------------------------------------------------
# Public origin used for member QR destinations. Set this to the exact HTTPS
# origin before a hosted build; do not print cards until it is confirmed.
NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example

# Leave unset: the API is served by this app at /api. Only set this to point
# the site at a separately hosted API.
# NEXT_PUBLIC_API_URL=

# --- API (server/) ----------------------------------------------------------
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Vercel sits behind one proxy hop. Use 0 locally.
TRUST_PROXY_HOPS=0
# Optional: defaults to NEXT_PUBLIC_SITE_URL. Only needed for an extra origin.
# FRONTEND_URL=

# --- Optional standalone API (`npm run start:api`) ----------------------------
# PORT=5000

# --- Optional legacy Vite adapter (tests and previews only) --------------------
VITE_API_URL=http://127.0.0.1:3000/api
VITE_PUBLIC_SITE_URL=https://your-verified-domain.example
