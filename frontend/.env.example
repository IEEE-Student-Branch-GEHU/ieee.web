# Vercel production API origin or origin with /api appended.
# The active production frontend is Vite.
VITE_API_URL=https://your-render-service.onrender.com/api

# Optional verified public origin used for member QR destinations. Leave unset
# until the production domain is confirmed; production QR downloads stay disabled.
VITE_PUBLIC_SITE_URL=https://your-verified-domain.example

# Only used by the incremental Next.js migration. VITE_API_URL takes
# precedence when both applications are built from this repository.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api
NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example
