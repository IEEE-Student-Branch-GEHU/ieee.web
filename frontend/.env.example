# Same-origin Next.js API. Leave this as /api for a single Vercel deployment.
NEXT_PUBLIC_API_URL=/api

# Primary public origin used for member QR destinations. Set this to the exact
# HTTPS origin before a hosted Next.js build; do not print cards until confirmed.
NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example

# Server-only Vercel variables. Never prefix these with NEXT_PUBLIC_ or expose
# them to browser code.
MONGODB_URI=mongodb+srv://user:password@example.mongodb.net/ieee
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Optional legacy Vite compatibility environment. NEXT_PUBLIC_* values take
# precedence when both applications are run from this repository.
VITE_API_URL=http://127.0.0.1:5000/api
VITE_PUBLIC_SITE_URL=https://your-verified-domain.example
